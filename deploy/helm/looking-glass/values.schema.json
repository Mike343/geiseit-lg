{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "quantity": {"type": ["string", "number"]},
    "resourceMap": {"type": "object", "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}},
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": ["string", "number"]},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
        "targetMemoryUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicaCount", "image", "podSecurityContext", "containerSecurityContext", "resources", "autoscaling", "pdb", "probes", "service"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {"const": true},
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1},
            "seccompProfile": {"type": "object", "properties": {"type": {"enum": ["RuntimeDefault", "Localhost"]}}}
          }
        },
        "containerSecurityContext": {
          "type": "object",
          "properties": {
            "allowPrivilegeEscalation": {"const": false},
            "readOnlyRootFilesystem": {"type": "boolean"},
            "privileged": {"const": false}
          }
        },
        "probes": {
          "type": "object",
          "required": ["livenessPath", "readinessPath", "initialDelaySeconds"],
          "properties": {
            "livenessPath": {"type": "string", "pattern": "^/"},
            "readinessPath": {"type": "string", "pattern": "^/"},
            "initialDelaySeconds": {
              "type": "object",
              "properties": {
                "startup": {"type": "integer", "minimum": 0},
                "readiness": {"type": "integer", "minimum": 0},
                "liveness": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        },
        "resources": {
          "type": "object",
          "properties": {"requests": {"$ref": "#/definitions/resourceMap"}, "limits": {"$ref": "#/definitions/resourceMap"}}
        },
        "tmpSizeLimit": {"type": "string"},
        "extraEmptyDirs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "mountPath", "sizeLimit"],
            "properties": {"name": {"type": "string"}, "mountPath": {"type": "string", "pattern": "^/"}, "sizeLimit": {"type": "string"}}
          }
        },
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "autoscaling": {"$ref": "#/definitions/autoscaling"},
        "pdb": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": ["integer", "string"]}}
        },
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/stringMap"},
        "priorityClassName": {"type": "string"},
        "nodeSelector": {"$ref": "#/definitions/stringMap"},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "extraEnv": {"type": "array", "items": {"type": "object", "required": ["name"]}},
        "extraVolumes": {"type": "array", "items": {"type": "object"}},
        "extraVolumeMounts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "stringList": {"type": "array", "items": {"type": "string"}},
    "monitorBase": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
      }
    }
  },
  "properties": {
    "global": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "namespace": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "podSecurity": {
          "type": "object",
          "properties": {
            "enforce": {"enum": ["privileged", "baseline", "restricted"]},
            "audit": {"enum": ["privileged", "baseline", "restricted"]},
            "warn": {"enum": ["privileged", "baseline", "restricted"]},
            "version": {"type": "string", "pattern": "^(latest|v1\\.[0-9]+)$"}
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "properties": {
        "http": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "metrics": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "probeDefaults": {"type": "object"},
    "scheduling": {
      "type": "object",
      "properties": {
        "podAntiAffinity": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
        "topologySpread": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "maxSkew": {"type": "integer", "minimum": 1},
            "topologyKey": {"type": "string"},
            "whenUnsatisfiable": {"enum": ["ScheduleAnyway", "DoNotSchedule"]}
          }
        }
      }
    },
    "lookingGlass": {
      "type": "object",
      "properties": {
        "location": {"type": "string"},
        "hostname": {"type": "string"},
        "asn": {"type": "string", "pattern": "^(AS[0-9]+)?$"},
        "network": {"type": "string"},
        "ipv4": {"type": "string"},
        "ipv6": {"type": "string"}
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "extraBlockedCidrs": {"$ref": "#/definitions/stringList"},
        "extraBlockedSuffixes": {"$ref": "#/definitions/stringList"}
      }
    },
    "otel": {"type": "object", "properties": {"endpoint": {"type": "string"}}},
    "web": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "apiInternalUrl": {"type": "string"},
                "nodeEnv": {"enum": ["production", "development", "test"]},
                "extra": {"type": "object"}
              }
            }
          }
        }
      ]
    },
    "api": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "properties": {
            "existingSecret": {"type": "string"},
            "secretEnv": {"type": "object"},
            "config": {
              "type": "object",
              "properties": {
                "diagnosticsBaseUrl": {"type": "string"},
                "diagnosticsTimeoutSeconds": {"type": "integer", "minimum": 1},
                "rateLimiting": {
                  "type": "object",
                  "properties": {
                    "pingPerMinute": {"type": "integer", "minimum": 1},
                    "traceroutePerMinute": {"type": "integer", "minimum": 1},
                    "mtrPerMinute": {"type": "integer", "minimum": 1},
                    "dnsPerMinute": {"type": "integer", "minimum": 1},
                    "maxConcurrentPerIp": {"type": "integer", "minimum": 1}
                  }
                },
                "trustedProxies": {"$ref": "#/definitions/stringList"},
                "forwardLimit": {"type": "integer", "minimum": 1},
                "activity": {
                  "type": "object",
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "retentionMinutes": {"type": "integer", "minimum": 1},
                    "maxItems": {"type": "integer", "minimum": 1}
                  }
                },
                "extra": {"type": "object"}
              }
            }
          }
        }
      ]
    },
    "diagnostics": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "properties": {
            "existingSecret": {"type": "string"},
            "secretEnv": {"type": "object"},
            "icmp": {"type": "object", "properties": {"pingGroupRange": {"type": "string", "pattern": "^([0-9]+ [0-9]+)?$"}}},
            "netRawFallback": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
            "config": {
              "type": "object",
              "properties": {
                "maxConcurrent": {"type": "integer", "minimum": 1},
                "maxQueued": {"type": "integer", "minimum": 0},
                "timeoutSeconds": {"type": "integer", "minimum": 1},
                "maxOutputBytes": {"type": "integer", "minimum": 1024},
                "redactPrivateHops": {"type": "boolean"},
                "simulated": {"type": "boolean"},
                "dnsResolvers": {"$ref": "#/definitions/stringList"},
                "connectivity": {
                  "type": "object",
                  "properties": {
                    "intervalSeconds": {"type": "integer", "minimum": 1},
                    "windowSeconds": {"type": "integer", "minimum": 60},
                    "ipv4Targets": {"$ref": "#/definitions/stringList"},
                    "ipv6Targets": {"$ref": "#/definitions/stringList"}
                  }
                },
                "egress": {"type": "object", "properties": {"ipv4": {"type": "string"}, "ipv6": {"type": "string"}}},
                "extra": {"type": "object"}
              }
            }
          }
        }
      ]
    },
    "bgp": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z]{2,}$|^$"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "nginx": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "proxyReadTimeout": {"type": "integer", "minimum": 1},
            "proxySendTimeout": {"type": "integer", "minimum": 1},
            "proxyBodySize": {"type": "string"}
          }
        },
        "tls": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}}},
        "certManager": {"type": "object", "properties": {"clusterIssuer": {"type": "string"}}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressControllerNamespaceSelector": {"$ref": "#/definitions/stringMap"},
        "ingressControllerPodSelector": {"$ref": "#/definitions/stringMap"},
        "monitoringNamespaceSelector": {"$ref": "#/definitions/stringMap"},
        "dns": {
          "type": "object",
          "properties": {
            "namespaceSelector": {"$ref": "#/definitions/stringMap"},
            "podSelector": {"$ref": "#/definitions/stringMap"}
          }
        },
        "otlpEgress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "namespaceSelector": {"$ref": "#/definitions/stringMap"},
            "podSelector": {"$ref": "#/definitions/stringMap"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "allowClusterDns": {"type": "boolean"},
            "exceptCidrs": {"$ref": "#/definitions/stringList"},
            "extraExceptCidrs": {"$ref": "#/definitions/stringList"}
          }
        }
      }
    },
    "rbac": {"type": "object", "properties": {"create": {"type": "boolean"}, "rules": {"type": "array"}}},
    "quota": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "hard": {"type": "object"}}},
    "limitRange": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "default": {"$ref": "#/definitions/resourceMap"},
        "defaultRequest": {"$ref": "#/definitions/resourceMap"},
        "max": {"$ref": "#/definitions/resourceMap"}
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {"$ref": "#/definitions/monitorBase"},
        "podMonitor": {"$ref": "#/definitions/monitorBase"},
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"type": "string"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "failureRatioThreshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "latencyP95ThresholdSeconds": {"type": "number", "exclusiveMinimum": 0},
            "rejectedPerSecondThreshold": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"type": "string"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}, "image": {"$ref": "#/definitions/image"}}
    }
  }
}
